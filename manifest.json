{
  "manifest_version": 3,
  "name": "Gemielle",
  "version": "3.0",
  "description": "Shows a switchable AI-character widget on Gemini, ChatGPT, Claude, and Grok, reacting live to AI/user status.",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "gemielle@tranankhanh",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/*"],
      "css": ["style.css"],
      "js": ["config.js", "shared.js", "adapter-gemini.js"]
    },
    {
      "matches": ["*://chatgpt.com/*", "*://chat.openai.com/*"],
      "css": ["style.css"],
      "js": ["config.js", "shared.js", "adapter-chatgpt.js"]
    },
    {
      "matches": ["*://claude.ai/*"],
      "css": ["style.css"],
      "js": ["config.js", "shared.js", "adapter-claude.js"]
    },
    {
      "matches": ["*://grok.com/*"],
      "css": ["style.css"],
      "js": ["config.js", "shared.js", "adapter-grok.js"]
    },
    {
      "matches": ["*://notebooklm.google.com/*"],
      "css": ["style.css"],
      "js": ["config.js", "shared.js", "adapter-notebooklm.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*/*.gif"],
      "matches": [
        "*://gemini.google.com/*",
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://grok.com/*",
        "*://notebooklm.google.com/*"
      ]
    }
  ]
}
