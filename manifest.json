{
  "manifest_version": 3,
  "name": "Gemielle",
  "version": "2.0",
  "description": "Shows an AI assistant widget on the bottom right corner of Gemini web to indicate AI and User status. Now with switchable characters.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/*"],
      "css": ["style.css"],
      "js": ["config.js", "content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*/*.gif"],
      "matches": ["*://gemini.google.com/*"]
    }
  ]
}
